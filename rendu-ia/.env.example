# Copier ce fichier en ".env" puis remplir une clé. Ne jamais publier ".env".

# --- Fournisseur (voir README, étape 1) -------------------------------------
# A. Gemini : clé de Google AI Studio, payée par les crédits de l'abonnement Google AI Pro.
#    Images, storyboard et upscale ; les vidéos se font dans Flow (fiche préparée par le programme).
GEMINI_API_KEY=

# B. fal.ai : une seule clé pour les images, le texte, l'upscale et les vidéos (Kling, Seedance).
#    Avec les deux clés, les images passent par Gemini et les vidéos par fal.ai.
FAL_KEY=

# Fournisseur des images : gemini si GEMINI_API_KEY est remplie, sinon fal
# RENDU_FOURNISSEUR=gemini

# --- Réglages facultatifs ---------------------------------------------------
# Les valeurs ci-dessous sont celles par défaut. Ne décommentez que ce que vous changez.

# Modèles Gemini : Nano Banana Pro pour les images (gemini-3.1-flash-image = Nano Banana 2,
# deux fois moins cher), et le modèle de texte qui écrit le storyboard (« aucun » : 4 plans types)
# RENDU_GEMINI_MODELE_IMAGE=gemini-3-pro-image
# RENDU_GEMINI_MODELE_TEXTE=gemini-3.5-flash

# Clé gratuite (projet sans facturation, voir README « Avec une clé gratuite ») : Nano Banana 2 Lite,
# présenté comme gratuit par Google (à tester), 3 images d'entrée et 1K au plus, pas d'upscale
# RENDU_GEMINI_MODELE_IMAGE=gemini-3.1-flash-lite-image

# Modèle d'image chez fal.ai (Nano Banana Pro, cité dans la vidéo)
# RENDU_MODELE_IMAGE=fal-ai/nano-banana-pro/edit
# Définition des images : 1K, 2K ou 4K (4K coûte environ deux fois plus cher)
# RENDU_RESOLUTION=2K
# Format : auto (même format que la capture), 9:16 (vertical, comme la vidéo), 16:9, 4:3, 1:1...
# RENDU_FORMAT=auto

# Modèle de texte chez fal.ai qui écrit le storyboard en regardant l'image (via OpenRouter).
# « aucun » : 4 plans types, sans appel au modèle de texte.
# RENDU_MODELE_LLM=anthropic/claude-sonnet-5.5

# Upscale chez fal.ai : modèle et facteur d'agrandissement (de 1 à 4).
# Avec Gemini, l'upscale régénère l'image en 4K.
# RENDU_MODELE_UPSCALE=fal-ai/seedvr/upscale/image
# RENDU_FACTEUR_UPSCALE=2

# Vidéo par fal.ai : kling (Kling 3 Pro, de 3 à 15 s) ou seedance (Seedance 2.0, de 4 à 15 s)
# RENDU_MODELE_VIDEO=kling
# RENDU_DUREE_VIDEO=5

# Nombre de demandes envoyées en même temps (de 1 à 8)
# RENDU_PARALLELE=3

# --- Réglages avancés -------------------------------------------------------
# Si fal.ai sort une nouvelle version d'un modèle vidéo avec les mêmes réglages :
# RENDU_ENDPOINT_VIDEO=fal-ai/kling-video/v3/pro/image-to-video
# Paramètres ajoutés tels quels aux demandes (objet JSON), à prendre dans la page API du modèle
# sur fal.ai, ou dans « generationConfig » de l'API Gemini. Par exemple une graine fixe :
# RENDU_OPTIONS_IMAGE={"seed": 42}
# RENDU_OPTIONS_UPSCALE={}
# RENDU_OPTIONS_VIDEO={}
