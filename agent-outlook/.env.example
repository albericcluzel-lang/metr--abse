# Copier ce fichier en ".env" puis remplir les valeurs. Ne jamais publier ".env".

# Application enregistrée dans Microsoft Entra ID (voir README, étape 2)
OUTLOOK_CLIENT_ID=
OUTLOOK_TENANT_ID=

# Clé API OpenAI (platform.openai.com) : distincte de l'abonnement ChatGPT Team
OPENAI_API_KEY=

# --- Réglages facultatifs ---------------------------------------------------
# Modèle OpenAI utilisé pour classer les mails (un modèle "mini" suffit)
# OPENAI_MODEL=gpt-4o-mini

# Permissions Microsoft demandées. Ajouter MailboxSettings.ReadWrite pour que
# la commande "setup" crée aussi les catégories de couleur dans Outlook.
# OUTLOOK_SCOPES=Mail.ReadWrite

# Nombre de caractères du mail envoyés à l'IA (plus = plus précis, plus cher)
# OUTLOOK_BODY_CHARS=1200

# En dessous de ce seuil de confiance (0 à 1), le mail reste dans la boîte de réception
# OUTLOOK_MIN_CONFIDENCE=0.6

# Dossier où sont gardés le jeton de connexion, l'historique et les résumés
# OUTLOOK_AGENT_HOME=~/.outlook_agent
