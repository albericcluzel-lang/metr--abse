# Copier ce fichier en ".env" puis remplir les valeurs. Ne jamais publier ".env".

# Application enregistrée dans Microsoft Entra ID (voir README, étape 2)
OUTLOOK_CLIENT_ID=
OUTLOOK_TENANT_ID=

# --- Fournisseur d'IA (voir README, étape 1) --------------------------------
# Décommentez UN des blocs ci-dessous.

# A. Modèle local Ollama : gratuit, rien ne sort du PC, aucune clé nécessaire
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_MODEL=ministral-3:3b

# B. Mistral AI (gratuit avec crédit mensuel) : désactivez d'abord l'entraînement dans admin.mistral.ai
# OPENAI_BASE_URL=https://api.mistral.ai/v1
# OPENAI_API_KEY=
# OPENAI_MODEL=ministral-8b-latest
# OUTLOOK_LLM_TEMPERATURE=0
# OUTLOOK_LLM_PAUSE=2
# OPENAI_MAX_RETRIES=5

# C. Google Gemini (gratuit via Google AI Studio)
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# OPENAI_API_KEY=
# OPENAI_MODEL=gemini-3.1-flash-lite
# OUTLOOK_LLM_PAUSE=5
# OPENAI_MAX_RETRIES=5

# D. Groq (gratuit)
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_API_KEY=
# OPENAI_MODEL=openai/gpt-oss-20b
# OUTLOOK_LLM_REASONING_EFFORT=low
# OUTLOOK_LLM_MAX_TOKENS=1024
# OUTLOOK_LLM_PAUSE=15

# OpenAI (API payante, platform.openai.com, distincte de l'abonnement ChatGPT) : seule la clé suffit
# OPENAI_API_KEY=

# --- Réglages avancés du fournisseur ----------------------------------------
# Pause minimale (secondes) entre deux appels, pour rester sous la limite par minute d'une offre gratuite
# OUTLOOK_LLM_PAUSE=0
# Nouvelles tentatives automatiques sur saturation ou erreur passagère
# OPENAI_MAX_RETRIES=2
# Paramètres envoyés au modèle ; « none » = ne pas les envoyer. En local : 0 et 512 par défaut.
# OUTLOOK_LLM_TEMPERATURE=none
# OUTLOOK_LLM_MAX_TOKENS=none
# OUTLOOK_LLM_REASONING_EFFORT=none
# Format de réponse : auto (schéma strict, sinon repli JSON puis texte), schema, json ou text
# OUTLOOK_JSON_MODE=auto

# --- Réglages facultatifs ---------------------------------------------------
# Permissions Microsoft demandées. Ajouter MailboxSettings.ReadWrite pour que
# la commande "setup" crée aussi les catégories de couleur dans Outlook.
# OUTLOOK_SCOPES=Mail.ReadWrite

# Nombre de caractères du mail envoyés à l'IA (plus = plus précis, plus cher ; 6000 au plus en local)
# OUTLOOK_BODY_CHARS=1200

# En dessous de ce seuil de confiance (0 à 1), le mail reste dans la boîte de réception
# OUTLOOK_MIN_CONFIDENCE=0.6

# Dossier où sont gardés le jeton de connexion, l'historique et les résumés
# OUTLOOK_AGENT_HOME=~/.outlook_agent
